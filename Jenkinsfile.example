pipeline {
    agent any

    environment {
        VERSION = '0.1.0'
        NEXUS_BASE_URL = 'http://2.27.22.23:8081'
        NPM_REGISTRY = "${NEXUS_BASE_URL}/repository/npm-hosted/"
        NEXUS_MAVEN_URL = "${NEXUS_BASE_URL}/repository/maven-releases/"
    }

    stages {
        stage('Checkout') {
            steps { checkout scm }
        }

        stage('Install Node') {
            steps {
                sh 'npm ci'
            }
        }

        stage('Build & Publish') {
            parallel {
                stage('TypeScript → Nexus npm') {
                    steps {
                        withCredentials([string(credentialsId: 'nexus-npm-token', variable: 'NEXUS_NPM_TOKEN')]) {
                            sh '''
                                npm run build:ts
                                echo "//2.27.22.23:8081/repository/npm-hosted/:_authToken=${NEXUS_NPM_TOKEN}" > .npmrc
                                echo "@example:registry=${NPM_REGISTRY}" >> .npmrc
                                npm publish -w @example/ui-backend-model
                            '''
                        }
                    }
                }
                stage('Java → Nexus Maven') {
                    steps {
                        withCredentials([usernamePassword(credentialsId: 'nexus-maven', usernameVariable: 'NEXUS_USERNAME', passwordVariable: 'NEXUS_PASSWORD')]) {
                            dir('packages/java') {
                                sh './gradlew clean build publish -PreleaseVersion=${VERSION}'
                            }
                        }
                    }
                }
            }
        }
    }
}
